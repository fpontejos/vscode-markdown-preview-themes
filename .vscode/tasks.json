{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "label": "npm: build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$esbuild"]
    },
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "problemMatcher": ["$esbuild-watch"],
      "presentation": { "reveal": "never" }
    },
    {
      "type": "npm",
      "script": "check",
      "label": "npm: check",
      "group": "test",
      "problemMatcher": ["$tsc", "$eslint-stylish"]
    }
  ]
}
