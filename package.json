        "markdownPreviewThemes.fontFamily": {
          "type": "string",
          "default": "",
          "order": 10,
          "markdownDescription": "Body font family for the preview, as a CSS `font-family` value. Empty inherits `#markdown.preview.fontFamily#`."
        },
        "markdownPreviewThemes.headingFontFamily": {
          "type": "string",
          "default": "",
          "order": 11,
          "description": "Font family for headings. Empty uses the body font."
        },
        "markdownPreviewThemes.codeFontFamily": {
          "type": "string",
          "default": "",
          "order": 12,
          "markdownDescription": "Font family for code. Empty inherits `#editor.fontFamily#`."
        },
        "markdownPreviewThemes.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "order": 13,
          "markdownDescription": "Body font size in px. `0` inherits `#markdown.preview.fontSize#`."
        },
        "markdownPreviewThemes.codeFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "order": 14,
          "description": "Code font size in px. 0 keeps it equal to the body size."
        },
        "markdownPreviewThemes.lineHeight": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "order": 15,
          "markdownDescription": "Unitless line height (for example `1.6`). `0` inherits `#markdown.preview.lineHeight#`."
        },
        "markdownPreviewThemes.maxWidth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "order": 16,
          "description": "Maximum content width in px, centred. 0 means full width."
        },
        "markdownPreviewThemes.colors": {
          "type": "object",
          "default": {},
          "order": 20,
          "additionalProperties": false,
          "description": "Colour overrides applied on top of the theme (hex values). Applied to both light and dark.",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "foreground": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "heading": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "link": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "codeBackground": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "codeForeground": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "border": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "blockquote": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            },
            "selection": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
              "format": "color-hex"
            }
          }
        },
        "markdownPreviewThemes.customCss": {
          "type": "string",
          "default": "",
          "order": 30,
          "editPresentation": "multilineText",
          "markdownDescription": "CSS appended after the theme. Target `body.vscode-body`. Edited live by **Markdown Preview Themes: Open Theme Editor**."
        },
        "markdownPreviewThemes.customCssPath": {
          "type": "string",
          "default": "",
          "order": 31,
          "description": "Path to a CSS file applied after the theme (absolute, ~-prefixed, or relative to the first workspace folder). Watched for changes."
        }
      }
    },
    "commands": [
      {
        "command": "markdownPreviewThemes.openEditor",
        "title": "Open Theme Editor",
        "category": "Markdown Preview Themes",
        "icon": "$(symbol-color)"
      },
      {
        "command": "markdownPreviewThemes.openThemeBrowserInEditor",
        "title": "Open Theme Browser",
        "category": "Markdown Preview Themes",
        "icon": "$(color-mode)"
      },
      {
        "command": "markdownPreviewThemes.openThemeBrowser",
        "title": "Open Theme Browser in Web Browser",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.selectTheme",
        "title": "Select Theme",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.selectLightTheme",
        "title": "Select Light Theme",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.selectDarkTheme",
        "title": "Select Dark Theme",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.nextTheme",
        "title": "Next Theme",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.previousTheme",
        "title": "Previous Theme",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.exportCss",
        "title": "Export Current Theme as CSS",
        "category": "Markdown Preview Themes"
      },
      {
        "command": "markdownPreviewThemes.previewAsMarkdown",
        "title": "Open Preview as Markdown (Quarto / other)",
        "category": "Markdown Preview Themes"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownPreviewThemes.openEditor",
          "group": "navigation@99",
          "when": "editorLangId == markdown || activeWebviewPanelId == markdown.preview"
        },
        {
          "command": "markdownPreviewThemes.openThemeBrowserInEditor",
          "group": "navigation@98",
          "when": "editorLangId == markdown || activeWebviewPanelId == markdown.preview"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownPreviewThemes.previewAsMarkdown",
          "when": "editorIsOpen"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "themes": "node scripts/extract-themes.mjs",
    "site": "node scripts/site.mjs",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run themes && npm run site && npm run bundle",
    "watch": "node scripts/bundle.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "node test/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "npm run check && vsce package --no-dependencies",
    "install-local": "npm run package && code --install-extension $(ls -t *.vsix | head -1) --force"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "postcss": "^8.5.31",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
