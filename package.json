{
  "name": "markdown-preview-themes",
  "displayName": "Markdown Preview Themes",
  "description": "Pick a colour theme and fonts for VS Code's built-in Markdown preview. Ships the CodeMirror themes used by programmingfonts.org, plus a live theme editor and custom CSS.",
  "version": "0.1.1",
  "publisher": "fpontejos",
  "repository": {
    "type": "git",
    "url": "https://github.com/fpontejos/vscode-markdown-preview-themes.git"
  },
  "bugs": {
    "url": "https://github.com/fpontejos/vscode-markdown-preview-themes/issues"
  },
  "homepage": "https://github.com/fpontejos/vscode-markdown-preview-themes#readme",
  "author": {
    "name": "Farina Pontejos"
  },
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme",
    "css",
    "fonts",
    "quarto"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "markdownPreviewThemes.customCssPath is read from the local file system and is ignored in virtual workspaces."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "markdownPreviewThemes.customCssPath",
        "markdownPreviewThemes.customCss"
      ],
      "description": "Workspace-level custom CSS settings are ignored until the workspace is trusted."
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "configuration": {
      "title": "Markdown Preview Themes",
      "properties": {
        "markdownPreviewThemes.mode": {
          "type": "string",
          "default": "fixed",
          "order": 0,
          "enum": [
            "fixed",
            "auto"
          ],
          "enumItemLabels": [
            "One theme",
            "Follow VS Code light / dark"
          ],
          "enumDescriptions": [
            "Always use `#markdownPreviewThemes.theme#`.",
            "Use `#markdownPreviewThemes.lightTheme#` when VS Code has a light colour theme and `#markdownPreviewThemes.darkTheme#` when dark."
          ],
          "markdownDescription": "How the preview theme is chosen. [Browse all themes](command:markdownPreviewThemes.openThemeBrowserInEditor)."
